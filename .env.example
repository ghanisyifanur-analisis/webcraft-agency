# ========================================================
# DATABASE CONFIGURATION
# 1. DOCKER ENVIRONMENT (Default SRS):
#    DB_CONNECTION=pgsql
#    DB_HOST=postgres_db
#    DB_PORT=5432
#    DB_DATABASE=webcraft_db
#    DB_USERNAME=webcraft_user
#    DB_PASSWORD=webcraft_secret
#
# 2. LOCAL TERMUX / MYSQL / SHARED HOSTING ENVIRONMENT:
#    DB_CONNECTION=mysql
#    DB_HOST=127.0.0.1
#    DB_PORT=3306
#    DB_DATABASE=webcraft_db
#    DB_USERNAME=root
#    DB_PASSWORD=
# ========================================================
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=webcraft_db
DB_USERNAME=webcraft_user
DB_PASSWORD=webcraft_secret

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# PAYMENT GATEWAY SANDBOX (Midtrans / Xendit)
MIDTRANS_SERVER_KEY=SB-Mid-server-SampleMockKeyWebCraft2026
MIDTRANS_CLIENT_KEY=SB-Mid-client-SampleMockKeyWebCraft2026
MIDTRANS_IS_PRODUCTION=false

# WHATSAPP GATEWAY (Fonnte / Twilio)
